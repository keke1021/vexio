generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model Tenant {
  id                 String       @id @default(cuid())
  name               String
  slug               String       @unique
  email              String       @unique
  phone              String?
  address            String?
  isActive           Boolean      @default(true)
  status             TenantStatus @default(ACTIVE)
  plan               TenantPlan   @default(FULL) // deprecated (ver enum), pero mientras exista, todo tenant nuevo entra con acceso completo por default
  activeModules      String[]     @default([])
  extraUsers         Int          @default(0)
  maxUsers           Int          @default(7) // límite real de usuarios del tenant, seteado a mano por SUPERADMIN. Reemplaza a PLAN_USER_LIMITS.FULL (7) como fuente de verdad — default 7 preserva el comportamiento actual de los tenants existentes (todos entraban con plan FULL). Ya no depende del plan.
  // DEPRECATED — informativo, se actualizaba a mano y no alimentaba ningún
  // cálculo. La cantidad real de sucursales de un tenant ahora sale de
  // contar sus filas de Tienda (ver modelo Tienda más abajo). No se borra
  // todavía por si algo no detectado sigue leyéndolo.
  storeCount         Int          @default(1)
  subscriptionEndsAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users          User[]
  tiendas        Tienda[]
  products       Product[]
  inventoryItems InventoryItem[]
  suppliers      Supplier[]
  sales          Sale[]
  customers      Customer[]
  repairOrders   RepairOrder[]
  cashSessions   CashSession[]
  cashMovements  CashMovement[]
  purchaseOrders PurchaseOrder[]
  payments       Payment[]
  notifications  Notification[]
  tickets        SupportTicket[]

  ledgerEntries    LedgerEntry[]
  conversions      Conversion[]
  stockTransfers   StockTransfer[]
  deliveries       Delivery[]
  supplierPayments SupplierPayment[]
}

enum Role {
  OWNER
  ADMIN
  SELLER
  TECH
  SUPERADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

// DEPRECATED — sin uso real en el pricing actual (confirmado 2026-08).
// No se borra todavía por si rompe algo no detectado (PLAN_MODULES en
// admin.controller.js sigue leyendo este campo), pero no alimenta ningún
// cálculo de facturación ni de límite de usuarios — eso ahora es
// Payment.amount (facturación) y Tenant.maxUsers (usuarios), ambos
// cargados a mano por SUPERADMIN. El límite de usuarios por plan
// (PLAN_USER_LIMITS) fue reemplazado por Tenant.maxUsers.
enum TenantPlan {
  STARTER
  PRO
  FULL
}

model User {
  id       String  @id @default(cuid())
  email    String
  password String
  name     String
  role     Role    @default(SELLER)
  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sucursal a la que pertenece este usuario. Opcional — un usuario sin
  // tiendaId asignada no está atado a ninguna sucursal en particular.
  // No filtra stock/caja/ventas (POS, Caja, Compras siguen sin restringir por
  // tienda del usuario). ÚNICA excepción: StockTransfer sí lo usa como
  // autorización real — ver assertTiendaAccess en utils/tiendaAuth.js. Un
  // SELLER/TECH sin tiendaId asignada queda bloqueado de ese módulo (fail
  // closed), OWNER/ADMIN/SUPERADMIN no están sujetos a esta restricción.
  tiendaId String?
  tienda   Tienda? @relation(fields: [tiendaId], references: [id])

  refreshTokens       RefreshToken[]
  sales               Sale[]
  technicianRepairs   RepairOrder[]         @relation("RepairTechnician")
  createdRepairs      RepairOrder[]         @relation("RepairCreator")
  repairComments      RepairComment[]
  repairStatusChanges RepairStatusHistory[]
  cashSessionsOpened  CashSession[]         @relation("CashOpened")
  cashSessionsClosed  CashSession[]         @relation("CashClosed")
  cashMovements       CashMovement[]        @relation("CashMovementCreator")
  tickets             SupportTicket[]
  ticketReplies       TicketReply[]
  supplierPayments    SupplierPayment[]

  ledgerEntries LedgerEntry[]
  conversions   Conversion[]
  notifications Notification[]

  stockTransfersCreated    StockTransfer[] @relation("StockTransferCreator")
  stockTransfersDispatched StockTransfer[] @relation("StockTransferDispatcher")

  stockTransferItemsAdded     StockTransferItem[] @relation("StockTransferItemAdder")
  stockTransferItemsReceived  StockTransferItem[] @relation("StockTransferItemReceiver")
  stockTransferItemsCancelled StockTransferItem[] @relation("StockTransferItemCanceller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sucursal activa de ESTA sesión (no del perfil del usuario). La elige el
  // usuario en el login (OWNER/ADMIN con >1 sucursal) o al cambiar de sucursal
  // (POST /auth/select-tienda). Null mientras un OWNER/ADMIN multi-sucursal
  // todavía no eligió. `POST /auth/refresh` re-emite el access token con esta
  // sucursal — así el reload completo tras un cambio de sucursal arranca ya
  // scopeado a la nueva. Dos navegadores del mismo usuario = dos filas = dos
  // sucursales activas independientes. onDelete: SetNull — borrar una sucursal
  // no invalida sesiones (refresh la recalcula).
  activeTiendaId String?
  activeTienda   Tienda? @relation(fields: [activeTiendaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ─── Sucursales ───────────────────────────────────────────────────────────────
// Alta/baja/edición de sucursales de un tenant y asignación opcional de
// usuarios a una de ellas. Reemplaza a Tenant.storeCount (deprecated) como
// fuente de verdad de "cuántas sucursales tiene este tenant" — esa cantidad
// sale de contar filas de Tienda.
//
// Etapa actual (2026-08-05): schema + backfill únicamente. InventoryItem,
// CashSession y Sale ya tienen tiendaId obligatorio y PurchaseOrder opcional,
// pero ningún controller todavía filtra ni valida por sucursal — eso es la
// próxima etapa. Ver StockTransfer y la regla de negocio documentada junto a
// Sale más abajo.

model Tienda {
  id      String  @id @default(cuid())
  name    String
  address String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  users User[]

  inventoryItems   InventoryItem[]
  cashSessions     CashSession[]
  sales            Sale[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  repairOrders     RepairOrder[]
  activeSessions   RefreshToken[]

  stockTransfersFrom StockTransfer[] @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[] @relation("StockTransferTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
}

// ─── Moneda ─────────────────────────────────────────────────────────────────
// Reemplaza los enums SaleCurrency y PaymentCurrency. Tabla global, sembrada
// una sola vez con ARS/USD/USDT — no es por-tenant.

model Currency {
  code     String  @id // "ARS" | "USD" | "USDT"
  name     String
  symbol   String
  decimals Int     @default(2) // reservado a futuro — hoy todas las columnas Decimal usan 2 decimales fijos, este campo no se usa todavía en ningún cálculo
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales              Sale[]
  saleItems          SaleItem[]
  cashMovements      CashMovement[]
  inventoryItems     InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  payments           Payment[]
  supplierPayments   SupplierPayment[]
  ledgerEntries      LedgerEntry[]

  ratesFrom       ExchangeRate[] @relation("ExchangeRateFrom")
  ratesTo         ExchangeRate[] @relation("ExchangeRateTo")
  conversionsFrom Conversion[]   @relation("ConversionFrom")
  conversionsTo   Conversion[]   @relation("ConversionTo")
}

// Tasa de referencia diaria — reemplaza el caché en memoria de rates.controller.js.
// Una fila por par de monedas por día. "1 fromCurrency = rate toCurrency".
model ExchangeRate {
  id String @id @default(cuid())

  fromCurrencyCode String
  fromCurrency     Currency @relation("ExchangeRateFrom", fields: [fromCurrencyCode], references: [code])
  toCurrencyCode   String
  toCurrency       Currency @relation("ExchangeRateTo", fields: [toCurrencyCode], references: [code])

  rate      Decimal  @db.Decimal(18, 6)
  source    String // "bluelytics" | "binance" | "manual"
  validDate DateTime @db.Date // día al que corresponde esta tasa (una por par/día)
  fetchedAt DateTime @default(now())

  salesUsingThis         Sale[]         @relation("SaleReferenceRate")
  cashMovementsUsingThis CashMovement[] @relation("CashMovementReferenceRate")

  @@unique([fromCurrencyCode, toCurrencyCode, validDate])
  @@index([validDate])
}

// Tipo de origen de cada movimiento del ledger. Determina qué FK de referencia
// va a estar poblada (ver comentario en LedgerEntry).
enum LedgerEntryType {
  SALE
  CASH_MOVEMENT_INCOME
  CASH_MOVEMENT_EXPENSE
  SESSION_OPEN
  SESSION_CLOSE_ADJUSTMENT
  PURCHASE_ORDER
  SUBSCRIPTION_PAYMENT
  CONVERSION
  // Pago a proveedor pagado desde una cuenta externa a la empresa (no desde
  // una caja del local). Solo trazabilidad de que se pagó y cuándo — nunca
  // afecta ningún balance de caja, por eso vive en
  // TENANT_BALANCE_EXCLUDED_TYPES igual que PURCHASE_ORDER/SUBSCRIPTION_PAYMENT
  // (ver src/utils/ledger.js). El caso "pagado desde la caja del local" NO
  // usa este type — reutiliza CASH_MOVEMENT_EXPENSE (mismo criterio que un
  // egreso manual de caja), porque ese sí tiene que restar del balance.
  SUPPLIER_PAYMENT_EXTERNAL
}

// Hecho financiero inmutable. Nunca se actualiza ni se borra desde la app —
// para corregir algo se agrega una entrada nueva que lo compense (reversal),
// no se edita la existente. (La app no expone update/delete para este modelo;
// evaluar más adelante una regla/trigger de Postgres si se quiere blindar a
// nivel DB también.)
//
// REGLA DE BALANCE — type=SUBSCRIPTION_PAYMENT: representa lo que el tenant
// (la tienda) le paga a Vexio por la suscripción. Vive en este mismo ledger
// por trazabilidad interna, pero NO es parte de la caja del negocio del
// tenant. Cualquier balance/resumen que se le muestre al dueño del tenant
// (Caja, Reportes, POS) debe filtrar `type != 'SUBSCRIPTION_PAYMENT'` por
// default. Solo las vistas de Admin/Billing (SUPERADMIN, sobre Vexio como
// negocio) pueden incluirlo. Recordar aplicar este filtro en cada query de
// balance que se escriba a partir del módulo Caja/reportes en adelante.
//
// REGLA DE BALANCE — type=PURCHASE_ORDER: se crea al marcar una
// PurchaseOrder como RECEIVED (no al crearla PENDING — recibirla es cuando
// el taller efectivamente asume la deuda con el proveedor). Registra que se
// generó una deuda, NO que salió plata de la caja en ese momento:
// PurchaseOrder no tiene paymentMethod, y Supplier.paymentDays (default 30)
// asume pago diferido, no inmediato desde el cajón. Por eso también se
// excluye de cualquier balance de caja mostrado al tenant, mismo criterio
// que SUBSCRIPTION_PAYMENT. El movimiento de caja real — cuando
// efectivamente se le paga al proveedor, sea al recibir la orden o a los 30
// días — todavía no existe como acción en el sistema (backlog, no
// implementado).
//
// Ambas exclusiones viven juntas en TENANT_BALANCE_EXCLUDED_TYPES
// (src/utils/ledger.js) — agregar ahí, no repetir la lista a mano en cada
// controller.
model LedgerEntry {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  amount Decimal         @db.Decimal(10, 2) // firmado: + entra, − sale
  type   LedgerEntryType

  // Tasa REAL aplicada en este movimiento puntual (no la de referencia diaria).
  // Null cuando el movimiento no involucra conversión (ej. venta en ARS pura).
  appliedRate     Decimal? @db.Decimal(18, 6)
  appliedRateBase String? // código de la moneda contra la que se expresa appliedRate

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  // Para type IN (SALE, CASH_MOVEMENT_INCOME, CASH_MOVEMENT_EXPENSE,
  // PURCHASE_ORDER, SUBSCRIPTION_PAYMENT, CONVERSION): exactamente una de
  // estas 6 referencias está poblada, según el type. Un pago a proveedor
  // desde caja (source=CASH_REGISTER) es type=CASH_MOVEMENT_EXPENSE y usa
  // cashMovementId como el resto de los egresos de caja — supplierPaymentId
  // es exclusivo de type=SUPPLIER_PAYMENT_EXTERNAL (pago desde cuenta
  // externa, sin CashMovement asociado).
  // Para type IN (SESSION_OPEN, SESSION_CLOSE_ADJUSTMENT): NINGUNA de estas
  // 6 referencias se completa — el único contexto es cashSessionId.
  saleId            String?
  sale              Sale?            @relation(fields: [saleId], references: [id])
  cashMovementId    String?
  cashMovement      CashMovement?    @relation(fields: [cashMovementId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  paymentId         String?
  payment           Payment?         @relation(fields: [paymentId], references: [id])
  conversionId      String?
  conversion        Conversion?      @relation(fields: [conversionId], references: [id])
  supplierPaymentId String?
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])

  description String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, currencyCode])
  @@index([tenantId, cashSessionId])
  @@index([tenantId, type])
}

// Dos LedgerEntry (uno negativo en fromCurrency, uno positivo en toCurrency)
// creados en una única transacción atómica. Soporta cualquier par ARS/USD/USDT,
// sin casos hardcodeados. El balance de origen se valida antes de ejecutar,
// calculado desde LedgerEntry, bajo pg_advisory_xact_lock(tenantId+currency)
// para evitar condición de carrera con otra operación concurrente.
model Conversion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fromCurrencyCode String
  fromCurrency     Currency @relation("ConversionFrom", fields: [fromCurrencyCode], references: [code])
  toCurrencyCode   String
  toCurrency       Currency @relation("ConversionTo", fields: [toCurrencyCode], references: [code])

  fromAmount Decimal @db.Decimal(10, 2)
  toAmount   Decimal @db.Decimal(10, 2)
  rate       Decimal @db.Decimal(18, 6) // toAmount / fromAmount, tasa real aplicada

  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  notes String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  entries LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─── Inventario ───────────────────────────────────────────────────────────────

model Product {
  id       String @id @default(cuid())
  name     String
  color    String
  storage  String
  minStock Int    @default(3)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  items InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, color, storage, tenantId])
}

enum Condition {
  NEW
  LIKE_NEW
  REFURBISHED
  USED
}

enum ItemStatus {
  AVAILABLE
  SOLD
  RESERVED
  DEFECTIVE
  // Poblado desde que el ítem se agrega a un lote de StockTransfer (todavía
  // EN_PREPARACION, ni siquiera despachado) hasta que se confirma su
  // recepción en destino — currentTransferId apunta al lote mientras tanto.
  // Ver StockTransferItem para el detalle del estado dentro del lote.
  IN_TRANSIT
}

model InventoryItem {
  id        String     @id @default(cuid())
  imei      String
  condition Condition  @default(NEW)
  status    ItemStatus @default(AVAILABLE)
  costPrice Decimal    @db.Decimal(10, 2)
  salePrice Decimal    @db.Decimal(10, 2)

  currencyCode String   @default("ARS")
  currency     Currency @relation(fields: [currencyCode], references: [code])

  accessories String[]
  notes       String?

  productId String
  product   Product @relation(fields: [productId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sucursal donde físicamente está el equipo. Obligatorio — reemplaza el
  // supuesto implícito anterior de "todo el stock del tenant está en un solo
  // lugar". Ver regla de negocio junto a Sale: una venta no puede incluir un
  // item de otra tienda ni uno IN_TRANSIT (no implementado todavía).
  tiendaId String
  tienda   Tienda @relation(fields: [tiendaId], references: [id])

  // Poblado solo mientras status=IN_TRANSIT — el lote (StockTransfer) donde
  // el ítem está actualmente EN_PREPARACION o EN_CAMINO. Null en cualquier
  // otro estado.
  currentTransferId String?
  currentTransfer   StockTransfer? @relation(fields: [currentTransferId], references: [id])

  // Historial completo de membresías en lotes de transferencia — a
  // diferencia de currentTransferId (solo la vigente), acá queda cada paso
  // por el que pasó el ítem a lo largo de su vida, incluidos los ya
  // resueltos (RECEIVED/CANCELLED).
  transferMemberships StockTransferItem[]

  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([imei, tenantId])
  @@index([tenantId, tiendaId])
}

model Supplier {
  id          String  @id @default(cuid())
  name        String
  city        String
  paymentDays Int     @default(30)
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
}

// ─── Transferencias entre sucursales ──────────────────────────────────────────
// Un lote (StockTransfer) se arma incrementalmente durante el día: cada IMEI
// agregado pasa de inmediato a InventoryItem.status=IN_TRANSIT (no vendible
// en el origen, aunque el camión no haya salido) y suma un StockTransferItem
// propio con su propio ciclo de vida. Al cerrar y despachar el lote
// (OPEN→DISPATCHED) se exige un Delivery asociado; a partir de ahí no se
// pueden agregar más ítems. El destino puede aceptar todo el lote de una
// (receive-all) o ítem por ítem (recepción parcial); lo no recibido queda
// DISPATCHED hasta que alguien lo reciba o lo cancele con motivo. Un ítem ya
// RECEIVED no se cancela — eso se resuelve con una transferencia inversa.
//
// StockTransfer.status es un campo propio (no derivado en cada lectura), pero
// se recalcula transaccionalmente en cada mutación que puede afectarlo
// (dispatch, receive, receive-all, cancel) — nunca se pisa "a mano" desde
// otro lado. El auto-cierre a CLOSED solo aplica sobre lotes ya DISPATCHED:
// cancelar el último ítem de un lote todavía OPEN lo deja OPEN y vacío, listo
// para seguir sumando ítems ese mismo día, no lo cierra.
enum StockTransferStatus {
  OPEN       // lote en armado (EN_PREPARACION) — se le pueden seguir agregando ítems
  DISPATCHED // cerrado + delivery asignado + salió físicamente (EN_CAMINO)
  CLOSED     // terminal: todos sus ítems están en RECEIVED o CANCELLED
}

enum StockTransferItemStatus {
  PREPARING  // agregado al lote, todavía no despachado (EN_PREPARACION)
  DISPATCHED // el lote salió, este ítem viaja (EN_CAMINO)
  RECEIVED   // confirmado en destino — InventoryItem pasa a AVAILABLE en destino
  CANCELLED  // perdido/dañado/error de carga — requiere cancelReason
}

// Catálogo de fleteros/transportistas, reutilizable entre despachos — mismo
// patrón que Supplier (scoped por tenant, alta rápida desde el flujo que lo
// necesita). A diferencia de Supplier, sin @@unique([name, tenantId]): puede
// haber dos fleteros con el mismo nombre sin ser la misma persona — la UI
// resuelve "reusar o crear nuevo" con un selector, no con una constraint que
// asuma nombres únicos.
model Delivery {
  id       String  @id @default(cuid())
  name     String
  phone    String
  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  transfers StockTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model StockTransfer {
  id     String              @id @default(cuid())
  status StockTransferStatus @default(OPEN)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fromTiendaId String
  fromTienda   Tienda @relation("StockTransferFrom", fields: [fromTiendaId], references: [id])
  toTiendaId   String
  toTienda     Tienda @relation("StockTransferTo", fields: [toTiendaId], references: [id])

  // Nullable hasta el dispatch — obligatorio asociar uno antes de esa
  // transición (OPEN→DISPATCHED), validado en el controller.
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])

  // Quien agregó el primer ítem — abrió el lote de forma implícita, no hay
  // una acción explícita de "crear lote vacío".
  createdById String
  createdBy   User   @relation("StockTransferCreator", fields: [createdById], references: [id])

  dispatchedById String?
  dispatchedBy   User?     @relation("StockTransferDispatcher", fields: [dispatchedById], references: [id])
  dispatchedAt   DateTime?

  // Poblado cuando TODOS los ítems del lote llegan a un estado terminal
  // (RECEIVED o CANCELLED) — no antes. No implica que todo haya llegado bien,
  // solo que no queda nada pendiente de resolver en este lote.
  closedAt DateTime?

  notes String?

  // Ítems actualmente EN VIVO apuntando acá (ver InventoryItem.currentTransferId).
  items InventoryItem[]
  // Historial completo del lote, incluidos los ítems ya resueltos.
  transferItems StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, fromTiendaId, status])
  @@index([tenantId, toTiendaId, status])
  // + índice único parcial (tenantId, fromTiendaId, toTiendaId) WHERE
  //   status='OPEN' vía migración raw SQL (Prisma DSL no soporta parciales —
  //   mismo caso que CashSession_tiendaId_open_unique). Garantiza un solo
  //   lote abierto por combinación origen→destino, incluso bajo altas
  //   concurrentes — ver migración 20260905030000_stock_transfer_constraints.
}

model StockTransferItem {
  id     String                   @id @default(cuid())
  status StockTransferItemStatus @default(PREPARING)

  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  addedById String
  addedBy   User   @relation("StockTransferItemAdder", fields: [addedById], references: [id])

  receivedById String?
  receivedBy   User?     @relation("StockTransferItemReceiver", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  cancelledById String?
  cancelledBy   User?     @relation("StockTransferItemCanceller", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())

  @@index([transferId])
  @@index([inventoryItemId])
  // + índice único parcial (inventoryItemId) WHERE status IN ('PREPARING',
  //   'DISPATCHED') vía migración raw SQL — mismo motivo que arriba. Esta es
  //   la garantía real de "un IMEI no puede estar en dos lotes vivos a la
  //   vez", a nivel DB y no solo de código — ver migración
  //   20260905030000_stock_transfer_constraints.
}

// ─── Punto de Venta ───────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  INSTALLMENTS
}

// ExchangeType eliminado — reemplazado por Sale.referenceRateId (FK trazable
// a la fila real de ExchangeRate usada, en vez de una etiqueta suelta).

// REGLA DE NEGOCIO — pendiente de implementar (próxima etapa, NO validado
// todavía a nivel de controller): una Sale no puede incluir un InventoryItem
// cuyo tiendaId sea distinto al tiendaId de la propia Sale, ni uno cuyo
// status sea IN_TRANSIT. El stock vendido siempre tiene que estar físicamente
// disponible en la misma sucursal donde se hace la venta.
model Sale {
  id            String        @id @default(cuid())
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod

  currencyCode String   @default("ARS")
  currency     Currency @relation(fields: [currencyCode], references: [code])

  customerName  String?
  customerPhone String?
  customerEmail String?
  notes         String?

  exchangeRate    Decimal?      @db.Decimal(18, 6)
  referenceRateId String?
  referenceRate   ExchangeRate? @relation("SaleReferenceRate", fields: [referenceRateId], references: [id])

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sucursal donde se hizo la venta. Obligatorio. Ver regla de negocio arriba.
  tiendaId String
  tienda   Tienda @relation(fields: [tiendaId], references: [id])

  items         SaleItem[]
  cashMovement  CashMovement?
  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, tiendaId])
}

model SaleItem {
  id        String  @id @default(cuid())
  salePrice Decimal @db.Decimal(10, 2) // ya convertido a Sale.currency
  costPrice Decimal @db.Decimal(10, 2) // ya convertido a Sale.currency

  // Snapshot del precio del InventoryItem en SU moneda original, antes de
  // cualquier conversión. Antes este dato se perdía por completo.
  originalCurrencyCode String
  originalCurrency     Currency @relation(fields: [originalCurrencyCode], references: [code])
  originalSalePrice    Decimal  @db.Decimal(10, 2)
  originalCostPrice    Decimal  @db.Decimal(10, 2)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  createdAt DateTime @default(now())
}

// ─── Reparaciones ─────────────────────────────────────────────────────────────
// (sin cambios — no depende de moneda unificada, budget queda como está)

model Customer {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  repairs RepairOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, tenantId])
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
  CANCELLED
}

enum FaultType {
  SCREEN
  BATTERY
  CHARGING
  CAMERA
  SPEAKER
  BUTTON
  WATER
  SOFTWARE
  OTHER
}

model RepairOrder {
  id               String    @id @default(cuid())
  customerName     String
  customerPhone    String
  deviceModel      String
  deviceColor      String?
  deviceImei       String?
  faultType        FaultType
  faultDescription String

  status        RepairStatus @default(RECEIVED)
  budget        Decimal?     @db.Decimal(10, 2)
  estimatedDate DateTime?
  readyAt       DateTime?
  deliveredAt   DateTime?
  // DEPRECATED: reemplazado por el thread de comentarios (RepairComment). Se
  // mantiene la columna para no perder el contenido histórico — el frontend lo
  // muestra como "nota heredada" de solo lectura si trae algo.
  internalNotes String?

  technicianId String?
  technician   User?   @relation("RepairTechnician", fields: [technicianId], references: [id])

  // Quién cargó la orden en el mostrador ("empleado"). Contraparte del técnico
  // en el thread de comentarios y destinatario de las notificaciones cuando el
  // taller responde. Nullable por las órdenes previas a esta migración.
  createdById String?
  createdBy   User?   @relation("RepairCreator", fields: [createdById], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sucursal física de la que proviene el equipo. Se completa al crear la
  // orden (createRepair la deriva de la sucursal activa de quien la carga, o
  // la elige explícitamente cuando el que carga no está atado a una sucursal
  // — ej. TECH). Nullable solo por las órdenes previas a esta migración
  // (backfill: primera Tienda del tenant). Scope: SELLER ve solo las de su
  // sucursal activa; TECH las ve TODAS (excepción explícita — el taller es uno
  // solo y recibe equipos de todas las sucursales), con esta sucursal de
  // origen siempre visible en lista/detalle.
  tiendaId String?
  tienda   Tienda? @relation(fields: [tiendaId], references: [id])

  statusHistory RepairStatusHistory[]
  comments      RepairComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, tiendaId])
}

// Thread de comentarios cronológico de una orden de reparación. Reemplaza al
// viejo campo único RepairOrder.internalNotes: cada comentario preserva autor y
// timestamp y no pisa a los anteriores. `fromTech` se congela al crear (rol del
// autor en ese momento) y define de qué lado del mostrador vino el comentario
// — con eso el frontend arma el badge "esperando respuesta de: empleado/técnico"
// mirando sólo el último comentario, y el backend sabe a quién notificar.
model RepairComment {
  id   String @id @default(cuid())
  body String

  repairId String
  repair   RepairOrder @relation(fields: [repairId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // true  => lo escribió el taller (rol TECH)
  // false => lo escribió el mostrador (OWNER/ADMIN/SELLER)
  fromTech Boolean

  createdAt DateTime @default(now())

  @@index([repairId, createdAt])
}

// ─── Proveedores / Compras ────────────────────────────────────────────────────

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id     String         @id @default(cuid())
  status PurchaseStatus @default(PENDING)
  total  Decimal        @db.Decimal(10, 2)

  currencyCode String   @default("ARS")
  currency     Currency @relation(fields: [currencyCode], references: [code])

  notes      String?
  receivedAt DateTime?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sucursal que recibe la mercadería. Opcional — se completa recién al
  // marcar la orden RECEIVED (ver backfill), no existe todavía al crearla
  // PENDING porque en ese momento no se sabe con certeza a qué sucursal va
  // a ingresar el stock.
  tiendaId String?
  tienda   Tienda? @relation(fields: [tiendaId], references: [id])

  items         PurchaseOrderItem[]
  ledgerEntries LedgerEntry[]
  // Pagos reales contra la deuda de esta orden (seña + saldo, uno o más,
  // cada uno con su propio origen) — ver modelo SupplierPayment. La orden en
  // sí no guarda "pagado"/"pendiente": se calculan siempre desde esta
  // relación (suppliers.controller.js, serializeOrder).
  payments      SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, tiendaId])
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  // Snapshot de la moneda pactada para este ítem al momento del pedido (antes
  // heredaba implícitamente la de PurchaseOrder; no hay "precio original de
  // InventoryItem" acá porque el equipo todavía no existe).
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Pagos a proveedores ───────────────────────────────────────────────────────
// Independiente del status de PurchaseOrder (PENDING o RECEIVED, no importa
// — son eventos separados, ver comentario en PurchaseOrder.payments). Cada
// fila es un pago parcial real (seña, saldo, o cualquier otro parcial) contra
// PurchaseOrder.total. "Pagado"/"pendiente" NUNCA se guardan como campo —
// siempre se calculan sumando estas filas (suppliers.controller.js).

enum PaymentSource {
  CASH_REGISTER // sale de una caja del local — requiere tiendaId + caja abierta ahí
  EXTERNAL // sale de una cuenta externa a la empresa — no toca ninguna caja
}

model SupplierPayment {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(10, 2)

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  source PaymentSource

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Obligatorio SOLO si source=CASH_REGISTER (de qué caja/sucursal salió la
  // plata) — null si es EXTERNAL, no hay sucursal involucrada. No lo valida
  // el schema (Prisma no tiene constraints condicionales); lo valida
  // suppliers.controller.js antes de crear la fila.
  tiendaId String?
  tienda   Tienda? @relation(fields: [tiendaId], references: [id])

  // Poblado únicamente cuando source=CASH_REGISTER — el CashMovement real
  // que restó este pago de la caja de esa sucursal. Null si es EXTERNAL.
  cashMovementId String?       @unique
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id])

  paidAt DateTime @default(now())

  paidById String
  paidBy   User   @relation(fields: [paidById], references: [id])

  notes String?

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([tenantId, purchaseOrderId])
}

// ─── Caja ─────────────────────────────────────────────────────────────────────

enum MovementType {
  INCOME
  EXPENSE
}

// CONSTRAINT DE DB NO REPRESENTABLE ACÁ (Prisma no soporta índices únicos
// parciales/filtrados en el schema DSL a esta versión): existe un índice
// único parcial `CashSession_tiendaId_open_unique` en
// (tiendaId) WHERE closedAt IS NULL — ver migración
// 20260905020000_cash_session_one_open_per_tienda. Garantiza a nivel DB que
// no puede haber más de una sesión abierta por tienda al mismo tiempo, ni
// siquiera bajo dos requests de apertura concurrentes (el chequeo
// findFirst de cash.controller.js/openCash es solo el fast-path optimista;
// esta es la guarda real). openCash captura el P2002 resultante y responde
// 409, mismo mensaje que el chequeo optimista.
model CashSession {
  // Se eliminan initialAmountARS, initialAmountUSD, finalAmount. El saldo
  // inicial por moneda es un LedgerEntry (type=SESSION_OPEN) por moneda
  // ingresada al abrir. El saldo final se calcula siempre on-demand desde
  // LedgerEntry; si al cerrar hay diferencia entre lo contado y lo calculado,
  // se registra como LedgerEntry type=SESSION_CLOSE_ADJUSTMENT (ajuste
  // explícito, no un número pisado).
  id       String    @id @default(cuid())
  openedAt DateTime  @default(now())
  closedAt DateTime?
  notes    String?

  openedById String
  openedBy   User   @relation("CashOpened", fields: [openedById], references: [id])

  closedById String?
  closedBy   User?   @relation("CashClosed", fields: [closedById], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Sucursal donde se abrió esta caja. Obligatorio.
  tiendaId String
  tienda   Tienda @relation(fields: [tiendaId], references: [id])

  movements     CashMovement[]
  ledgerEntries LedgerEntry[]
  conversions   Conversion[]

  @@index([tenantId, tiendaId])
}

model CashMovement {
  id     String       @id @default(cuid())
  type   MovementType
  amount Decimal      @db.Decimal(10, 2)

  currencyCode String   @default("ARS")
  currency     Currency @relation(fields: [currencyCode], references: [code])

  exchangeRate    Decimal?      @db.Decimal(18, 6)
  referenceRateId String?
  referenceRate   ExchangeRate? @relation("CashMovementReferenceRate", fields: [referenceRateId], references: [id])

  description   String
  paymentMethod PaymentMethod

  sessionId String
  session   CashSession @relation(fields: [sessionId], references: [id])

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdById String
  createdBy   User   @relation("CashMovementCreator", fields: [createdById], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ledgerEntries LedgerEntry[]

  // Back-relation del lado FK único en SupplierPayment.cashMovementId — un
  // pago a proveedor desde caja (source=CASH_REGISTER) genera exactamente
  // uno de estos, igual patrón que Sale/saleId más arriba.
  supplierPayment SupplierPayment?

  createdAt DateTime @default(now())
}

model RepairStatusHistory {
  id     String       @id @default(cuid())
  status RepairStatus
  notes  String?

  repairId String
  repair   RepairOrder @relation(fields: [repairId], references: [id], onDelete: Cascade)

  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])

  createdAt DateTime @default(now())
}

// ─── Admin / Pagos ────────────────────────────────────────────────────────────
// Payment = pago de suscripción tenant → Vexio (billing del SaaS, no caja de
// la tienda). Entra al mismo LedgerEntry (type=SUBSCRIPTION_PAYMENT) para que
// toda plata que se mueve viva en un único lugar, filtrable por type.
// Ver regla de balance sobre SUBSCRIPTION_PAYMENT en el comentario de
// LedgerEntry — no debe aparecer en balances/reportes del tenant, solo en
// vistas de Admin/Billing.

// Sin esto, "cuánto facturé este mes" mezclaba cobros de implementación
// (pago único, grande) con mensualidades (recurrente, chico) — mismo tipo de
// bug que el resto del proyecto, a nivel de la facturación de Vexio mismo.
enum PaymentType {
  IMPLEMENTATION
  MONTHLY
}

model Payment {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(10, 2)

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])

  paymentType PaymentType

  paidAt DateTime
  notes  String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
}

// ─── Notificaciones ───────────────────────────────────────────────────────────

enum NotificationType {
  INFO
  WARNING
  DANGER
}

model Notification {
  id      String           @id @default(cuid())
  message String
  type    NotificationType @default(INFO)
  read    Boolean          @default(false)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Destinatario. null => notificación tenant-wide (la ve cualquier usuario del
  // tenant: alertas de stock bajo, etc. — comportamiento histórico). Seteado =>
  // notificación DIRIGIDA (transferencia pendiente de recibir, respuesta en un
  // ticket, respuesta en el thread de una reparación): sólo la ve ese usuario.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Ruta del frontend a la que lleva el click en la campanita (ej.
  // "/transfers/abc123"). null => la notificación sólo se marca como leída.
  link String?

  createdAt DateTime @default(now())

  @@index([tenantId, read])
  @@index([userId, read])
}

// ─── Soporte ──────────────────────────────────────────────────────────────────

enum TicketCategory {
  ERROR_SISTEMA
  CONSULTA_GENERAL
  PROBLEMA_MODULO
  SUGERENCIA
  FACTURACION
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
}

enum TicketStatus {
  ABIERTO
  EN_PROCESO
  RESUELTO
}

model SupportTicket {
  id          String         @id @default(cuid())
  title       String
  description String
  category    TicketCategory
  priority    TicketPriority @default(MEDIA)
  status      TicketStatus   @default(ABIERTO)
  attachments String[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  replies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketReply {
  id          String   @id @default(cuid())
  message     String
  attachments String[]
  isAdmin     Boolean  @default(false)

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
